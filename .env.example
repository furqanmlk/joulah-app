# Google Sheets Configuration
# Get your API key from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_API_KEY=your_api_key_here

# Get the Sheet ID from the URL of your Google Sheet
# Example: https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit
VITE_GOOGLE_SHEET_ID=your_sheet_id_here

# Sheet range (optional, default is "Sheet1")
# Examples: "Sheet1", "Sheet1!A1:D10", "MyData"
VITE_SHEET_RANGE=Sheet1
